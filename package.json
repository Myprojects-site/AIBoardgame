{
  "name": "ai-boardgame",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "build": "npm run build -w client",
    "typecheck": "tsc -p . && tsc -p client",
    "test": "node --test \"packages/**/test/*.test.ts\"",
    "cards": "node tools/make_cards.ts",
    "sim": "node tools/simulate.ts",
    "e2e": "node tools/e2e.ts",
    "art:list": "node tools/art_list.ts",
    "art": "python -I tools/import_art.py"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3"
  }
}